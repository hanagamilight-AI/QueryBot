# QueryBot Environment Configuration
# Copy this file to .env and update with your values

# Application
APP_NAME="QueryBot - Political Intelligence AI"
APP_VERSION="1.0.0"
DEBUG=False

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/querybot
PGVECTOR_DIMENSION=768

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# LLM Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.7
MAX_TOKENS=2048

# LangGraph Configuration
GRAPH_MEMORY_TYPE=conversation_buffer
GRAPH_MAX_ITERATIONS=10

# MCP Servers
MCP_SERVERS=database,pgvector,external_apis

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Data Ingestion
DATA_SOURCE_DIRS=data/elections,data/surveys,data/social_media,data/manifestos
SUPPORTED_FORMATS=.json,.csv,.txt,.pdf

# AWS (optional - for EC2 deployment)
AWS_REGION=us-east-1
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
